<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="7x7">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Paredes en sistema de coordenadas 0-7 m -->
    <!-- Pared oeste: X=0, cubre Y de 0 a 7 -->
    <model name="wall_left_ext">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>7 0.1 1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>7 0.1 1</size></box></geometry>
        </collision>
      </link>
      <pose>0 3.5 0.5 0 0 1.5708</pose>
    </model>

    <!-- Pared este: X=7, cubre Y de 0 a 7 -->
    <model name="wall_right_ext">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>7 0.1 1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>7 0.1 1</size></box></geometry>
        </collision>
      </link>
      <pose>7 3.5 0.5 0 0 1.5708</pose>
    </model>

    <!-- Pared norte: Y=7, cubre X de 0 a 7 -->
    <model name="wall_top_ext">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>7 0.1 1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>7 0.1 1</size></box></geometry>
        </collision>
      </link>
      <pose>3.5 7 0.5 0 0 0</pose>
    </model>

    <!-- Pared sur: Y=0, cubre X de 0 a 7 -->
    <model name="wall_bottom_ext">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>7 0.1 1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>7 0.1 1</size></box></geometry>
        </collision>
      </link>
      <pose>3.5 0 0.5 0 0 0</pose>
    </model>
  </world>
</sdf>